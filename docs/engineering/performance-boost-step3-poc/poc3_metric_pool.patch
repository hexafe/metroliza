+def _step3_metric_chart_specs(task):
+    """STEP3 PoC: one metric's chart specs in the serial loop's order (runs in-process or in a worker)."""
+    (metric, metric_frame, metric_population_source_frame, aggregate_frame, aggregation,
+     chart_group_columns, charts, plotly_visual_settings, include_plotly_specs, population_layer_mode) = task
+    specs_out: list[dict[str, Any]] = []
+    if charts.time_series:
+        specs = _build_time_series_charts(
+            metric,
+            raw_frame=metric_frame,
+            static_population_source_frame=metric_population_source_frame,
+            aggregate_frame=aggregate_frame,
+            aggregation=aggregation,
+            group_columns=chart_group_columns,
+            plotly_visual_settings=plotly_visual_settings,
+            include_plotly_specs=include_plotly_specs,
+            population_layer_mode=population_layer_mode,
+        )
+        specs_out.extend(spec for spec in specs if spec)
+    if charts.histogram:
+        spec = _build_histogram_chart(
+            metric,
+            metric_frame,
+            group_columns=chart_group_columns,
+            plotly_visual_settings=plotly_visual_settings,
+            include_plotly_specs=include_plotly_specs,
+        )
+        if spec:
+            specs_out.append(spec)
+    for chart_type, enabled in (("violin", charts.violin), ("box", charts.box)):
+        if not enabled:
+            continue
+        spec = _build_distribution_chart(
+            metric,
+            metric_frame,
+            chart_type=chart_type,
+            group_columns=chart_group_columns,
+            plotly_visual_settings=plotly_visual_settings,
+            include_plotly_specs=include_plotly_specs,
+        )
+        if spec:
+            specs_out.append(spec)
+    return specs_out
+
+
+def _step3_map_metric_tasks(tasks):
+    """STEP3 PoC: ordered per-metric results; spawn pool when STEP3_POC_METRIC_WORKERS > 0."""
+    import os
+
+    workers = int(os.environ.get("STEP3_POC_METRIC_WORKERS", "0") or 0)
+    if workers <= 0 or len(tasks) < 2:
+        return [_step3_metric_chart_specs(task) for task in tasks]
+    from concurrent.futures import ProcessPoolExecutor
+
+    from metroliza.shared.compute_worker import spawn_context
+
+    with ProcessPoolExecutor(max_workers=min(workers, len(tasks)), mp_context=spawn_context()) as executor:
+        return list(executor.map(_step3_metric_chart_specs, tasks))
+
